<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>br.dev.plataforma</groupId>
  <artifactId>plataforma-multitenant</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Plataforma Multi-tenant</name>
  <description>Plataforma de estudo: pedidos B2B + pagamentos, multi-tenant, em microsserviços</description>

  <modules>
    <module>libs/platform-core</module>
    <module>libs/contracts</module>
    <module>services/status-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Cobertura mínima exigida pelo CI (dias 1 a 10) -->
    <jacoco.minimo.linhas>0.80</jacoco.minimo.linhas>
    <jacoco.version>0.8.13</jacoco.version>
    <spotless.version>2.46.1</spotless.version>
    <google-java-format.version>1.28.0</google-java-format.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>br.dev.plataforma</groupId>
        <artifactId>platform-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Testcontainers + JaCoCo: o agente vem do argLine preparado pelo JaCoCo -->
            <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
            <systemPropertyVariables>
              <!-- Avro 1.12 só desserializa classes confiáveis: as geradas em libs/contracts -->
              <org.apache.avro.SERIALIZABLE_PACKAGES>br.dev.plataforma.contracts</org.apache.avro.SERIALIZABLE_PACKAGES>
            </systemPropertyVariables>
            <!-- Testes de integração (*IT) rodam junto, para entrarem na cobertura -->
            <includes>
              <include>**/*Test.java</include>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>verificar-formatacao</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>relatorio</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>cobertura-minima</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.minimo.linhas}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
