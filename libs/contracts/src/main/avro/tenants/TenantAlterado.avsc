{
  "type": "record",
  "name": "TenantAlterado",
  "namespace": "br.dev.plataforma.contracts.tenants",
  "doc": "Plano, nível de isolamento ou situação de um tenant mudou.",
  "x-evento": "tenant.alterado",
  "x-topico": "persistent://plataforma/tenants/tenant.alterado.v1",
  "x-produtor": "tenants",
  "x-consumidores": [
    "catalogo",
    "pedidos",
    "pagamentos",
    "gateway"
  ],
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Identificador único do evento; chave da deduplicação nos consumidores."
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Tenant dono do agregado. Também compõe a chave da mensagem (tenantId:aggregateId)."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Instante em que o fato aconteceu no serviço de origem (UTC)."
    },
    {
      "name": "traceparent",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Contexto W3C Trace Context, para o trace atravessar o Pulsar."
    },
    {
      "name": "nome",
      "type": "string"
    },
    {
      "name": "plano",
      "type": "br.dev.plataforma.contracts.tenants.Plano"
    },
    {
      "name": "nivelIsolamento",
      "type": "br.dev.plataforma.contracts.tenants.NivelIsolamento"
    },
    {
      "name": "ativo",
      "type": "boolean",
      "doc": "Falso quando o tenant foi suspenso."
    },
    {
      "name": "versao",
      "type": "long",
      "default": 0,
      "doc": "Versão do cadastro do tenant (começa em 0 e sobe a cada alteração). tenant.criado e tenant.alterado chegam por tópicos diferentes, sem ordem entre si: o consumidor guarda a maior versão vista e ignora eventos com versão menor ou igual."
    }
  ]
}
