{
  "type": "record",
  "name": "PedidoConfirmado",
  "namespace": "br.dev.plataforma.contracts.pedidos",
  "doc": "O pagamento foi aprovado e o pedido está confirmado.",
  "x-evento": "pedido.confirmado",
  "x-topico": "persistent://plataforma/pedidos/pedido.confirmado.v1",
  "x-produtor": "pedidos",
  "x-consumidores": [],
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Identificador único do evento; chave da deduplicação nos consumidores."
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Tenant dono do agregado. Também compõe a chave da mensagem (tenantId:aggregateId)."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Instante em que o fato aconteceu no serviço de origem (UTC)."
    },
    {
      "name": "traceparent",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Contexto W3C Trace Context, para o trace atravessar o Pulsar."
    },
    {
      "name": "pedidoId",
      "type": "string"
    },
    {
      "name": "pagamentoId",
      "type": "string"
    },
    {
      "name": "versao",
      "type": "long",
      "default": 0,
      "doc": "Versão do pedido (@Version do documento). Consumidores ignoram versão menor ou igual à última recebida neste tópico para o pedido."
    }
  ]
}
