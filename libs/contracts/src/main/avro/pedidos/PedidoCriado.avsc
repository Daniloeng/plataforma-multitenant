{
  "type": "record",
  "name": "PedidoCriado",
  "namespace": "br.dev.plataforma.contracts.pedidos",
  "doc": "Um cliente do tenant fez um pedido; ele fica pendente até o pagamento.",
  "x-evento": "pedido.criado",
  "x-topico": "persistent://plataforma/pedidos/pedido.criado.v1",
  "x-produtor": "pedidos",
  "x-consumidores": [
    "pagamentos"
  ],
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Identificador único do evento; chave da deduplicação nos consumidores."
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Tenant dono do agregado. Também compõe a chave da mensagem (tenantId:aggregateId)."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Instante em que o fato aconteceu no serviço de origem (UTC)."
    },
    {
      "name": "traceparent",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Contexto W3C Trace Context, para o trace atravessar o Pulsar."
    },
    {
      "name": "pedidoId",
      "type": "string"
    },
    {
      "name": "clienteId",
      "type": "string",
      "doc": "Empresa compradora (B2B) dentro do tenant."
    },
    {
      "name": "itens",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "ItemPedido",
          "fields": [
            {
              "name": "produtoId",
              "type": "string"
            },
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "quantidade",
              "type": "int"
            },
            {
              "name": "precoUnitarioCentavos",
              "type": "long",
              "doc": "Preço no momento do pedido. Em centavos, para evitar erro de ponto flutuante."
            }
          ]
        }
      }
    },
    {
      "name": "totalCentavos",
      "type": "long",
      "doc": "Valor total do pedido. Em centavos, para evitar erro de ponto flutuante."
    },
    {
      "name": "moeda",
      "type": "string",
      "default": "BRL",
      "doc": "Código ISO 4217."
    },
    {
      "name": "versao",
      "type": "long",
      "default": 0,
      "doc": "Versão do pedido (@Version do documento). Consumidores ignoram versão menor ou igual à última recebida neste tópico para o pedido."
    }
  ]
}
