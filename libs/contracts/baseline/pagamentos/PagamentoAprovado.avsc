{
  "type": "record",
  "name": "PagamentoAprovado",
  "namespace": "br.dev.plataforma.contracts.pagamentos",
  "doc": "O pagamento do pedido foi autorizado e capturado.",
  "x-evento": "pagamento.aprovado",
  "x-topico": "persistent://plataforma/pagamentos/pagamento.aprovado.v1",
  "x-produtor": "pagamentos",
  "x-consumidores": [
    "pedidos"
  ],
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Identificador único do evento; chave da deduplicação nos consumidores."
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Tenant dono do agregado. Também compõe a chave da mensagem (tenantId:aggregateId)."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Instante em que o fato aconteceu no serviço de origem (UTC)."
    },
    {
      "name": "traceparent",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Contexto W3C Trace Context, para o trace atravessar o Pulsar."
    },
    {
      "name": "pagamentoId",
      "type": "string"
    },
    {
      "name": "pedidoId",
      "type": "string"
    },
    {
      "name": "valorCentavos",
      "type": "long",
      "doc": "Valor capturado. Em centavos, para evitar erro de ponto flutuante."
    },
    {
      "name": "moeda",
      "type": "string",
      "default": "BRL",
      "doc": "Código ISO 4217."
    },
    {
      "name": "chaveIdempotencia",
      "type": "string",
      "doc": "Garante que o mesmo pedido não é cobrado duas vezes."
    }
  ]
}
