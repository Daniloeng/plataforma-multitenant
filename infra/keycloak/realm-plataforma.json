{
  "realm": "plataforma",
  "enabled": true,
  "displayName": "Plataforma Multi-tenant",
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR",
    "en"
  ],
  "defaultLocale": "pt-BR",
  "roles": {
    "realm": [
      {
        "name": "plataforma-admin",
        "description": "Administra a plataforma: cadastro de tenants (plano administrativo, ADR-0005)."
      },
      {
        "name": "gestor-tenant",
        "description": "Gerencia catálogo e pedidos dos tenants a que pertence."
      },
      {
        "name": "comprador",
        "description": "Usuário de um cliente B2B: faz pedidos em nome do seu cliente (ADR-0007)."
      }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "subGroups": [
        {
          "name": "acme"
        },
        {
          "name": "globex"
        },
        {
          "name": "initech"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "plataforma-frontend",
      "name": "Frontend",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:4173/*"
      },
      "protocolMappers": [
        {
          "name": "tenants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "tenants",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "cliente_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "cliente_id",
            "claim.name": "cliente_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "plataforma-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "plataforma-cli",
      "name": "Testes e curl (só local)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "tenants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "tenants",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "cliente_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "cliente_id",
            "claim.name": "cliente_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "plataforma-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "email": "admin@exemplo.dev",
      "credentials": [
        {
          "type": "password",
          "value": "senha123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "plataforma-admin"
      ],
      "groups": []
    },
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Souza",
      "email": "ana@exemplo.dev",
      "credentials": [
        {
          "type": "password",
          "value": "senha123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "gestor-tenant"
      ],
      "groups": [
        "/tenants/acme",
        "/tenants/globex"
      ]
    },
    {
      "username": "bruno",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bruno",
      "lastName": "Lima",
      "email": "bruno@exemplo.dev",
      "credentials": [
        {
          "type": "password",
          "value": "senha123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "comprador"
      ],
      "groups": [
        "/tenants/acme"
      ],
      "attributes": {
        "cliente_id": [
          "cli-bruno"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [], \"unmanagedAttributePolicy\": \"ADMIN_VIEW\"}"
          ]
        }
      }
    ]
  }
}
